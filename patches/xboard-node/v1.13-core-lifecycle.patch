@@ -0,0 +1,91 @@
+package machine
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/cedar2025/xboard-node/internal/config"
+	"github.com/cedar2025/xboard-node/internal/controlplane"
+	"github.com/cedar2025/xboard-node/internal/panel"
+)
+
+func TestRemoveNodeDuringInitialConfigPreservesReplacement(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var enterOnce, releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasSuffix(r.URL.Path, "/config") {
+			enterOnce.Do(func() { close(entered); <-release })
+		}
+		http.Error(w, "fixture unavailable", http.StatusServiceUnavailable)
+	}))
+	defer ts.Close()
+	defer unblock()
+	o := New(&config.Config{
+		Panel:   config.PanelConfig{URL: ts.URL},
+		Machine: &config.MachineConfig{MachineID: 1},
+		Kernel:  config.KernelConfig{Type: "singbox", ConfigDir: t.TempDir()},
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	started := make(chan struct{})
+	go func() { o.startNode(ctx, panel.MachineNode{ID: 1, Type: "vless"}); close(started) }()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("initial config not requested")
+	}
+	stopped := make(chan struct{})
+	go func() { o.stopNode(1); close(stopped) }()
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		o.mu.Lock()
+		_, exists := o.nodes[1]
+		o.mu.Unlock()
+		if !exists {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("node not removed")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	// A new discovery may register this ID while the old config request is
+	// still returning. Old startup/exit must only touch its own generation.
+	mb := controlplane.NewNodeMailbox()
+	replacement := &nodeHandle{mailbox: mb}
+	o.mu.Lock()
+	o.nodes[1] = replacement
+	o.mu.Unlock()
+	o.eventsMu.Lock()
+	o.mailboxes[1] = mb
+	o.eventsMu.Unlock()
+	status := make(chan controlplane.StatusChange, 1)
+	o.registerNode(1, mb, status)
+	unblock()
+	select {
+	case <-started:
+	case <-time.After(3 * time.Second):
+		t.Fatal("startup did not complete")
+	}
+	select {
+	case <-stopped:
+	case <-time.After(3 * time.Second):
+		t.Fatal("old done channel was not closed")
+	}
+	o.mu.Lock()
+	if o.nodes[1] != replacement || replacement.service != nil || replacement.err != nil {
+		t.Error("old startup changed replacement handle")
+	}
+	o.mu.Unlock()
+	o.eventsMu.RLock()
+	if o.mailboxes[1] != mb || o.statuses[1] != status {
+		t.Error("old exit unregistered replacement")
+	}
+	o.eventsMu.RUnlock()
+}
