+)
+
+func TestLifecycleRetryRetainsDesiredAndIsIdempotent(t *testing.T) {
+	k := &fakeKernel{startErr: errors.New("listen tcp: address already in use")}
+	s := newTestService(k)
+	s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+	users := []model.UserSpec{{ID: 1, UUID: "test-user"}}
+	s.applyUserUpdate(context.Background(), users, computeUserHash(users))
+	st := s.Status()
+	if st.Ready || st.State != "error" || st.AppliedUsers != 0 || st.Users != 1 || st.Error == "" || st.RetryAt == 0 {
+		t.Fatalf("invalid failed status: %+v", st)
+	}
+	s.applyUserUpdate(context.Background(), users, computeUserHash(users))
+	s.reconcileKernel(context.Background())
+	if k.startCalls != 1 {
+		t.Fatal("duplicate events bypassed retry backoff")
+	}
+	k.startErr = nil
+	s.retryAt = time.Now().Add(-time.Second)
+	s.reconcileKernel(context.Background())
+	st = s.Status()
+	if !st.Ready || st.State != "running" || st.AppliedUsers != 1 || st.Error != "" || st.RetryAt != 0 {
+		t.Fatalf("invalid recovered status: %+v", st)
+	}
+	s.reconcileKernel(context.Background())
+	if k.startCalls != 2 || k.reloadCalls != 0 || k.updateCalls != 0 {
+		t.Fatalf("redundant apply: starts=%d reloads=%d updates=%d", k.startCalls, k.reloadCalls, k.updateCalls)
+	}
+}
+
+func TestLifecycleUserAndConfigOrdering(t *testing.T) {
+	for _, configFirst := range []bool{true, false} {
+		t.Run(map[bool]string{true: "config_first", false: "users_first"}[configFirst], func(t *testing.T) {
+			k := &fakeKernel{}
+			s := newTestService(k)
+			cfg := controlplane.Event{Type: controlplane.EventSyncConfig, Config: &model.NodeSpec{Protocol: "vless", ServerPort: 17881}}
+			users := controlplane.Event{Type: controlplane.EventSyncUsers, Users: []model.UserSpec{{ID: 1, UUID: "test-user"}}}
+			first, second := cfg, users
+			if !configFirst {
+				first, second = users, cfg
+			}
+			s.handleWSEvent(context.Background(), first)
+			if k.running || s.Status().Ready {
+				t.Fatal("incomplete intent reported ready")
+			}
+			s.handleWSEvent(context.Background(), second)
+			if !k.running || !s.Status().Ready || k.startCalls != 1 {
+				t.Fatal("complete intent did not start")
+			}
+			s.handleWSEvent(context.Background(), cfg)
+			s.handleWSEvent(context.Background(), users)
+			if k.startCalls != 1 || k.reloadCalls != 0 || k.updateCalls != 0 {
+				t.Fatal("duplicate events reapplied kernel")
+			}
+		})
+	}
+}
+
+func TestLifecycleRestartStopsBeforeStart(t *testing.T) {
+	k := &fakeKernel{running: true, reloadErr: errors.New("reload failed")}
+	s := newTestService(k)
+	s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+	s.updateUserState([]model.UserSpec{{ID: 1, UUID: "test-user"}})
+	s.recordApplied()
+	s.forceReload = true
+	s.reconcileKernel(context.Background())
+	if !k.running || k.stopCalls != 1 || k.startCalls != 1 || !s.Status().Ready {
+		t.Fatalf("unsafe fallback: stops=%d starts=%d status=%+v", k.stopCalls, k.startCalls, s.Status())
+	}
+}
+
+func TestLifecycleStaleRESTCannotOverwriteNewPush(t *testing.T) {
+	k := &fakeKernel{}
+	s := newTestService(k)
+	s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+	s.updateUserState([]model.UserSpec{})
+	old := pullResult{users: []model.UserSpec{}, userHash: computeUserHash(nil), checkRevision: true, revision: s.stateRevision}
+	s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncUsers, Users: []model.UserSpec{{ID: 1, UUID: "test-user"}}})
+	s.applyPullResult(context.Background(), old)
+	if !k.running || len(s.lastUsers) != 1 || !s.wsResyncPending.Load() {
+		t.Fatal("stale REST result overwrote newer push")
+	}
+}
+
+func TestLifecycleBackoffCapsAndNewIntentCanRecover(t *testing.T) {
+	k := &fakeKernel{startErr: errors.New("start failure")}
+	s := newTestService(k)
+	s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+	s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "first"}}, "")
+	for i := 0; i < 10; i++ {
+		s.retryAt = time.Now().Add(-time.Second)
+		s.reconcileKernel(context.Background())
+	}
+	if s.retryDelay != 30*time.Second {
+		t.Fatalf("uncapped retry: %v", s.retryDelay)
+	}
+	k.startErr = nil
+	s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "second"}}, "")
+	if !k.running || !s.Status().Ready || s.appliedState.Users[0].UUID != "second" {
+		t.Fatal("new valid intent did not recover")
+	}
+}
+
+func TestLifecycleRESTRefreshesMachineDeltaBaseline(t *testing.T) {
+	a := model.UserSpec{ID: 1, UUID: "A"}
+	b := model.UserSpec{ID: 2, UUID: "B"}
+	for _, seedWithA := range []bool{true, false} {
+		t.Run(map[bool]string{true: "revoke_then_add", false: "grant_then_add"}[seedWithA], func(t *testing.T) {
+			k := &fakeKernel{}
+			s := newTestService(k)
+			s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+			initial, next := []model.UserSpec{}, []model.UserSpec{a}
+			if seedWithA {
+				initial, next = next, initial
+			}
+			s.updateUserState(initial)
+			s.machineMailbox = controlplane.NewNodeMailbox()
+			s.markMailboxReadyAndDrain(context.Background())
+			s.applyPullResult(context.Background(), pullResult{users: next, userHash: computeUserHash(next), mailboxRevision: s.machineMailbox.Revision()})
+			s.machineMailbox.Apply(controlplane.Event{Type: controlplane.EventSyncUserDelta, DeltaAction: "add", DeltaUsers: []model.UserSpec{b}})
+			s.drainMachineMailbox(context.Background())
+			want := append(next, b)
+			if computeUserHash(s.lastUsers) != computeUserHash(want) {
+				t.Fatalf("REST baseline lost: users=%+v want=%+v", s.lastUsers, want)
+			}
+		})
+	}
+}
+
+func TestLifecyclePendingMachinePushWinsOverREST(t *testing.T) {
+	k := &fakeKernel{}
+	s := newTestService(k)
+	s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+	s.updateUserState([]model.UserSpec{})
+	s.machineMailbox = controlplane.NewNodeMailbox()
+	s.markMailboxReadyAndDrain(context.Background())
+	old := pullResult{users: []model.UserSpec{}, userHash: computeUserHash(nil), checkRevision: true, revision: s.stateRevision, mailboxRevision: s.machineMailbox.Revision()}
+	user := model.UserSpec{ID: 1, UUID: "new"}
+	s.machineMailbox.Apply(controlplane.Event{Type: controlplane.EventSyncUserDelta, DeltaAction: "add", DeltaUsers: []model.UserSpec{user}})
+	s.applyPullResult(context.Background(), old)
+	if !s.wsResyncPending.Load() {
+		t.Fatal("undrained push was overwritten by REST")
+	}
+	s.drainMachineMailbox(context.Background())
+	if !k.running || len(s.lastUsers) != 1 {
+		t.Fatal("new push did not start kernel")
+	}
+}
+
+func TestLifecycleInvalidNewConfigIsNotReadyAndCorrectionRecovers(t *testing.T) {
+	k := &fakeKernel{}
+	s := newTestService(k)
+	s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+	s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "user"}}, "")
+	s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncConfig, Config: &model.NodeSpec{Protocol: "vless", TLS: 2, ServerPort: 17881}})
+	if k.running || s.Status().Ready || s.Status().State != "error" {
+		t.Fatal("invalid desired config still reported ready")
+	}
+	s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncConfig, Config: &model.NodeSpec{Protocol: "vless", ServerPort: 17881}})
+	if !k.running || !s.Status().Ready {
+		t.Fatal("valid correction did not recover")
+	}
+}
+
+type bootstrapOnlySource struct {
+	controlplane.Source
+	bootstrap controlplane.Bootstrap
+}
+
+func (f bootstrapOnlySource) Initial(context.Context, func() map[string]interface{}, chan<- controlplane.Event, chan<- controlplane.StatusChange) (controlplane.Bootstrap, error) {
+	return f.bootstrap, nil
+}
+
+type bootstrapPush struct{}
+
+func (bootstrapPush) Run(ctx context.Context)           { <-ctx.Done() }
+func (bootstrapPush) IsConnected() bool                 { return true }
+func (bootstrapPush) SendDeviceReport(map[int][]string) {}
+
+func TestLifecycleInitialStartFailureKeepsRecoverableService(t *testing.T) {
+	k := &fakeKernel{startErr: errors.New("listen: address already in use")}
+	s := newTestService(k)
+	s.source = bootstrapOnlySource{bootstrap: controlplane.Bootstrap{
+		Config: &model.NodeSpec{Protocol: "vless", ServerPort: 17881},
+		Users:  []model.UserSpec{{ID: 1, UUID: "A"}},
+	}}
+	if err := s.initialSetup(context.Background()); err != nil {
+		t.Fatalf("recoverable start failure terminated service: %v", err)
+	}
+	if s.Status().State != "error" || s.retryAt.IsZero() {
+		t.Fatal("missing retry state")
+	}
+	k.startErr = nil
+	s.retryAt = time.Now().Add(-time.Second)
+	s.reconcileKernel(context.Background())
+	if !s.Status().Ready || k.startCalls != 2 {
+		t.Fatal("initial failure did not recover without new event")
+	}
+}
+
+func TestLifecycleBootstrapUsersWaitForConfig(t *testing.T) {
+	k := &fakeKernel{}
+	s := newTestService(k)
+	s.source = bootstrapOnlySource{bootstrap: controlplane.Bootstrap{
+		Users: []model.UserSpec{{ID: 1, UUID: "A"}}, Push: bootstrapPush{},
+	}}
+	if err := s.initialSetup(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if s.Status().State != "waiting_config" || len(s.lastUsers) != 1 || k.running {
+		t.Fatal("bootstrap users lost before config")
+	}
+	s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncConfig, Config: &model.NodeSpec{Protocol: "vless", ServerPort: 17881}})
+	if !s.Status().Ready || k.startCalls != 1 {
+		t.Fatal("later config did not activate retained users")
+	}
+}
+
+func TestLifecycleStartMustActuallyRun(t *testing.T) {
