+++ b/cmd/xboard-node/health_test.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+	"github.com/cedar2025/xboard-node/internal/service"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestReadinessRequiresEveryConfiguredCore(t *testing.T) {
+	p := newReadinessProbe()
+	p.reset(2)
+	assert := func(path string, expected int) {
+		r := httptest.NewRecorder()
+		p.handler().ServeHTTP(r, httptest.NewRequest(http.MethodGet, path, nil))
+		if r.Code != expected {
+			t.Fatalf("%s status=%d want=%d body=%s", path, r.Code, expected, r.Body)
+		}
+		if strings.Contains(r.Body.String(), "sensitive-error") {
+			t.Fatal("health endpoint exposed raw kernel error")
+		}
+	}
+	assert("/healthz", 200)
+	assert("/readyz", 503)
+	p.set(0, func() []service.CoreStatus {
+		return []service.CoreStatus{{State: "running", Ready: true, Users: 1, AppliedUsers: 1}}
+	})
+	assert("/readyz", 503)
+	p.set(1, func() []service.CoreStatus { return []service.CoreStatus{{State: "error", Error: "sensitive-error"}} })
+	assert("/readyz", 503)
+	p.set(1, func() []service.CoreStatus {
+		return []service.CoreStatus{{State: "running", Ready: true, Users: 1, AppliedUsers: 1}}
+	})
+	assert("/readyz", 200)
+	p.set(1, func() []service.CoreStatus { return []service.CoreStatus{{State: "waiting_users"}} })
+	assert("/readyz", 503)
+	assert("/healthz", 200)
+	p.reset(1)
+	assert("/readyz", 503)
+}
