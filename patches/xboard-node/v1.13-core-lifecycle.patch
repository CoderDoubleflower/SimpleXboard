diff --git a/internal/service/reconciliation_http_test.go b/internal/service/reconciliation_http_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f2b893d35d69b24aa57769e252b5fee7efa6592
--- /dev/null
+++ b/internal/service/reconciliation_http_test.go
@@ -0,0 +1,196 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/cedar2025/xboard-node/internal/config"
+	"github.com/cedar2025/xboard-node/internal/controlplane"
+	"github.com/cedar2025/xboard-node/internal/model"
+	"github.com/cedar2025/xboard-node/internal/panel"
+)
+
+type etagFixture struct {
+	mu              sync.Mutex
+	users           []panel.User
+	etag            string
+	lastIfNoneMatch string
+	entered         chan struct{}
+	release         chan struct{}
+}
+
+func (f *etagFixture) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if strings.HasSuffix(r.URL.Path, "/config") {
+		w.Header().Set("ETag", "config-v1")
+		if r.Header.Get("If-None-Match") == "config-v1" {
+			w.WriteHeader(http.StatusNotModified)
+			return
+		}
+		_, _ = w.Write([]byte(`{"protocol":"vless","server_port":17881}`))
+		return
+	}
+	if !strings.HasSuffix(r.URL.Path, "/user") {
+		http.NotFound(w, r)
+		return
+	}
+	f.mu.Lock()
+	users, etag := append([]panel.User{}, f.users...), f.etag
+	f.lastIfNoneMatch = r.Header.Get("If-None-Match")
+	entered, release := f.entered, f.release
+	f.entered, f.release = nil, nil
+	f.mu.Unlock()
+	if entered != nil {
+		close(entered)
+		<-release
+	}
+	w.Header().Set("ETag", etag)
+	if r.Header.Get("If-None-Match") == etag {
+		w.WriteHeader(http.StatusNotModified)
+		return
+	}
+	_ = json.NewEncoder(w).Encode(panel.UsersResponse{Users: users})
+}
+
+func (f *etagFixture) set(users []panel.User, etag string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.users, f.etag = users, etag
+}
+
+func (f *etagFixture) block(t *testing.T) (<-chan struct{}, func()) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.entered, f.release = make(chan struct{}), make(chan struct{})
+	entered, release := f.entered, f.release
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	t.Cleanup(unblock)
+	return entered, unblock
+}
+
+func etagService(t *testing.T, machine bool, f *etagFixture) (*Service, *fakeKernel) {
+	t.Helper()
+	ts := httptest.NewServer(f)
+	t.Cleanup(ts.Close)
+	k := &fakeKernel{}
+	s := newTestService(k)
+	pc := config.PanelConfig{URL: ts.URL, NodeID: 1}
+	if machine {
+		pc.MachineID = 1
+		s.source = controlplane.NewMachinePanelControlPlane(panel.NewClient(pc), s.cfg.Kernel, nil, nil)
+	} else {
+		s.source = controlplane.NewPanelControlPlane(pc, config.WSConfig{}, s.cfg.Kernel)
+	}
+	s.pullResults = make(chan pullResult, 1)
+	snapshot, err := s.source.Poll(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.lastConfig, s.lastConfigHash = snapshot.Config, computeConfigHash(snapshot.Config)
+	s.updateUserState(snapshot.Users)
+	s.reconcileKernel(context.Background())
+	return s, k
+}
+
+func awaitPoll(t *testing.T, s *Service) pullResult {
+	t.Helper()
+	var result pullResult
+	select {
+	case result = <-s.pullResults:
+	case <-time.After(3 * time.Second):
+		t.Fatal("REST poll did not return")
+	}
+	deadline := time.Now().Add(time.Second)
+	for s.pullActive.Load() {
+		if time.Now().After(deadline) {
+			t.Fatal("REST poll did not finish")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	return result
+}
+
+func TestLifecycleDiscardedRESTSnapshotClearsETags(t *testing.T) {
+	for _, machine := range []bool{false, true} {
+		t.Run(map[bool]string{false: "panel", true: "machine"}[machine], func(t *testing.T) {
+			f := &etagFixture{users: []panel.User{}, etag: "empty"}
+			s, k := etagService(t, machine, f)
+			f.set([]panel.User{{ID: 1, UUID: "A"}}, "A")
+			entered, release := f.block(t)
+			s.pullViaAPIAsync(context.Background())
+			select {
+			case <-entered:
+			case <-time.After(3 * time.Second):
+				t.Fatal("GET users not reached")
+			}
+			// Even a repeated config event supersedes an in-flight snapshot.
+			s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncConfig, Config: s.lastConfig})
+			release()
+			s.applyPullResult(context.Background(), awaitPoll(t, s))
+			if len(s.lastUsers) != 0 || !s.wsResyncPending.Load() {
+				t.Fatal("stale result was not deferred")
+			}
+			s.pullViaAPIAsync(context.Background())
+			s.applyPullResult(context.Background(), awaitPoll(t, s))
+			f.mu.Lock()
+			conditional := f.lastIfNoneMatch
+			f.mu.Unlock()
+			if conditional != "" || !k.running || !s.Status().Ready || len(s.lastUsers) != 1 {
+				t.Fatalf("forced full resync missing: If-None-Match=%q state=%+v", conditional, s.Status())
+			}
+			// Normal conditional polling resumes, and 304 preserves applied users.
+			s.pullViaAPIAsync(context.Background())
+			unchanged := awaitPoll(t, s)
+			if unchanged.users != nil {
+				t.Fatal("expected actual 304 user response")
+			}
+			s.applyPullResult(context.Background(), unchanged)
+			if !s.Status().Ready || k.startCalls != 1 {
+				t.Fatal("304 changed live lifecycle")
+			}
+		})
+	}
+}
+
+func TestLifecycleReconnectRestoresPreviouslyCachedUsers(t *testing.T) {
+	for _, connected := range []bool{false, true} {
+		t.Run(map[bool]string{false: "disconnect", true: "reconnect"}[connected], func(t *testing.T) {
+			f := &etagFixture{users: []panel.User{{ID: 1, UUID: "A"}}, etag: "A"}
+			s, k := etagService(t, true, f)
+			s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncUsers, Users: []model.UserSpec{}})
+			if k.running {
+				t.Fatal("revoked last user kept serving")
+			}
+			// The panel re-authorizes A while offline. Its ETag is again A, but
+			// desired state is empty. An old conditional poll is already in flight.
