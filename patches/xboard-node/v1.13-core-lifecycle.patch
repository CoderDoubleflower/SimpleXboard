index 0000000000000000000000000000000000000000..b73633b09984bf36a40d2255fe91753c82d8b7e3
--- /dev/null
+++ b/internal/panel/ws_users_test.go
@@ -0,0 +1,52 @@
+package panel
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// Decode the actual JSON envelope before dispatch so the full snapshot's []
+// semantics cannot be hidden by constructing a WSEvent directly in tests.
+func TestWSClientHandleDataEventSyncUsers(t *testing.T) {
+	cases := []struct {
+		name       string
+		data       string
+		wantEvent  bool
+		wantUsers  int
+		wantNodeID int
+	}{
+		{"empty_machine_snapshot", `{"node_id":42,"users":[]}`, true, 0, 42},
+		{"empty_legacy_snapshot", `{"users":[]}`, true, 0, 0},
+		{"populated_snapshot", `{"node_id":42,"users":[{"id":1,"uuid":"A"}]}`, true, 1, 42},
+		{"weak_numeric_fields", `{"node_id":"42","users":[{"id":"1","uuid":"A"}]}`, true, 1, 42},
+		{"missing_users", `{"node_id":42}`, false, 0, 0},
+		{"null_users", `{"node_id":42,"users":null}`, false, 0, 0},
+		{"object_users", `{"node_id":42,"users":{}}`, false, 0, 0},
+		{"string_users", `{"node_id":42,"users":""}`, false, 0, 0},
+		{"null_payload", `null`, false, 0, 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var received []WSEvent
+			ws := &WSClient{onEvent: func(event WSEvent) { received = append(received, event) }}
+			var message wsMessage
+			if err := json.Unmarshal([]byte(`{"event":"sync.users","data":`+tc.data+`}`), &message); err != nil {
+				t.Fatal(err)
+			}
+			ws.handleDataEvent(message)
+			if !tc.wantEvent {
+				if len(received) != 0 {
+					t.Fatalf("malformed snapshot emitted an event: %+v", received)
+				}
+				return
+			}
+			if len(received) != 1 {
+				t.Fatalf("expected one authoritative snapshot, got %d", len(received))
+			}
+			event := received[0]
+			if event.Type != WSEventSyncUsers || event.NodeID != tc.wantNodeID || event.Users == nil || len(event.Users) != tc.wantUsers {
+				t.Fatalf("snapshot semantics lost: %+v", event)
+			}
+		})
+	}
+}
