+package service
+
+import (
+	"context"
+	"testing"
+
+	"github.com/cedar2025/xboard-node/internal/controlplane"
+	"github.com/cedar2025/xboard-node/internal/model"
+)
+
+// This file deliberately uses only v1.13 APIs so it can be copied to the
+// unpatched tag to demonstrate the production failure before applying fixes.
+func TestEmptyBootstrapUserTransitions(t *testing.T) {
+	for _, transport := range []string{"ws_full", "ws_delta", "rest_reconcile", "machine_mailbox_delta"} {
+		t.Run(transport, func(t *testing.T) {
+			k := &fakeKernel{}
+			s := newTestService(k)
+			s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+			s.lastConfigHash = computeConfigHash(s.lastConfig)
+			s.updateUserState([]model.UserSpec{})
+			if transport == "machine_mailbox_delta" {
+				s.machineMailbox = controlplane.NewNodeMailbox()
+				s.markMailboxReadyAndDrain(context.Background())
+			}
+			user := model.UserSpec{ID: 1, UUID: "00000000-0000-4000-8000-000000000001"}
+			apply := func(users []model.UserSpec) {
+				switch transport {
+				case "ws_full":
+					s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncUsers, Users: users})
+				case "ws_delta", "machine_mailbox_delta":
+					action := "add"
+					if len(users) == 0 {
+						action = "remove"
+					}
+					event := controlplane.Event{Type: controlplane.EventSyncUserDelta, DeltaAction: action, DeltaUsers: []model.UserSpec{user}}
+					if transport == "machine_mailbox_delta" {
+						s.machineMailbox.Apply(event)
+						s.drainMachineMailbox(context.Background())
+					} else {
+						s.handleWSEvent(context.Background(), event)
+					}
+				case "rest_reconcile":
+					s.applyPullResult(context.Background(), pullResult{users: users, userHash: computeUserHash(users)})
+				}
+			}
+			apply([]model.UserSpec{user})
+			if !k.running || k.startCalls != 1 {
+				t.Fatalf("empty bootstrap did not start on first user: running=%v starts=%d", k.running, k.startCalls)
+			}
+			apply([]model.UserSpec{user})
+			if k.startCalls != 1 {
+				t.Fatalf("duplicate snapshot restarted kernel: %d", k.startCalls)
+			}
+			apply([]model.UserSpec{})
+			if k.running {
+				t.Fatal("last user removal did not stop kernel")
+			}
+			apply([]model.UserSpec{user})
+			if !k.running || k.startCalls != 2 {
+				t.Fatalf("second 0->1 transition failed: running=%v starts=%d", k.running, k.startCalls)
+			}
+		})
+	}
+}
