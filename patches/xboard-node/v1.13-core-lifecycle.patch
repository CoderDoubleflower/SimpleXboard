+}
+
+func TestLifecycleUnexpectedKernelStopInvalidatesReadinessAndRecovers(t *testing.T) {
+	k := &fakeKernel{}
+	s := newTestService(k)
+	s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+	s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "A"}}, "")
+	k.running = false
+	if st := s.Status(); st.Ready || st.State != "error" || st.AppliedUsers != 0 {
+		t.Fatalf("stopped kernel reported ready: %+v", st)
