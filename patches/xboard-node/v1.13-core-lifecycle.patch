+// CoreStatus distinguishes received intent from the state applied to a kernel.
+// users is the desired user count; applied_users is zero while stopped/failed.
+type CoreStatus struct {
+	State        string `json:"state"`
+	Ready        bool   `json:"ready"`
+	Users        int    `json:"users"`
+	AppliedUsers int    `json:"applied_users"`
+	Error        string `json:"error,omitempty"`
+	RetryAt      int64  `json:"retry_at,omitempty"`
+}
+
+// Status is safe to call from health endpoints and transport goroutines.
+func (s *Service) Status() CoreStatus {
+	s.metricsMu.RLock()
+	status := s.coreStatus
+	status.Users = len(s.lastUsers)
+	s.metricsMu.RUnlock()
+	if status.State == "" {
+		status.State = "waiting_config"
+	}
+	if status.Ready && !s.kernel.IsRunning() {
+		status.State = "error"
+		status.Ready = false
+		status.AppliedUsers = 0
+		status.Error = "kernel is not running"
+	}
+	return status
+}
+
+func (s *Service) setCoreStatus(state, message string) {
+	s.metricsMu.Lock()
+	s.coreStatus = CoreStatus{State: state, Ready: state == "running", Users: len(s.lastUsers), Error: message}
+	if state == "running" {
+		s.coreStatus.AppliedUsers = len(s.appliedState.Users)
+	}
+	if !s.retryAt.IsZero() {
+		s.coreStatus.RetryAt = s.retryAt.Unix()
+	}
+	s.metricsMu.Unlock()
+}
+
+func (s *Service) resetRetry() {
+	s.retryAt = time.Time{}
+	s.retryDelay = 0
+}
+
+func (s *Service) failKernel(err error) {
+	// A partially applied user/config update is not safe to keep serving.
+	// Stop also prevents the next retry from binding the same listener twice.
+	s.kernel.Stop()
+	s.appliedState.Config = nil
+	s.appliedState.Users = nil
+	if s.retryDelay == 0 {
+		s.retryDelay = time.Second
+	} else if s.retryDelay < 30*time.Second {
+		s.retryDelay *= 2
+		if s.retryDelay > 30*time.Second {
+			s.retryDelay = 30 * time.Second
+		}
+	}
+	s.retryAt = time.Now().Add(s.retryDelay)
+	s.setCoreStatus("error", err.Error())
+	nlog.Core().Error("kernel apply failed; retry scheduled", "error", err, "retry_in", s.retryDelay)
+}
+
+func (s *Service) stopKernel(state string) {
+	if s.kernel.IsRunning() {
+		s.kernel.Stop()
+	}
+	s.appliedState.Config = nil
+	s.appliedState.Users = nil
+	s.resetRetry()
+	s.setCoreStatus(state, "")
+}
+
+func (s *Service) recordApplied() {
+	s.appliedState.Config = s.lastConfig
+	s.appliedState.Users = append([]model.UserSpec(nil), s.lastUsers...)
+	s.forceReload = false
+	s.resetRetry()
+	s.setCoreStatus("running", "")
+}
