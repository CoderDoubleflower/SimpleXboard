+	s := newTestService(k)
+	s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+	s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "A"}}, "")
+	if st := s.Status(); st.Ready || st.State != "error" || st.AppliedUsers != 0 || st.RetryAt == 0 {
+		t.Fatalf("false successful Start reported ready: %+v", st)
