+++ b/cmd/xboard-node/health.go
@@ -0,0 +1,79 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"sync"
+
+	"github.com/cedar2025/xboard-node/internal/service"
+)
+
+// Readiness aggregates every configured instance. The endpoint exposes only
+// counts/states, never panel addresses, credentials, or raw kernel errors.
+type readinessProbe struct {
+	mu        sync.RWMutex
+	expected  int
+	providers map[int]func() []service.CoreStatus
+}
+
+func newReadinessProbe() *readinessProbe {
+	return &readinessProbe{providers: make(map[int]func() []service.CoreStatus)}
+}
+func (p *readinessProbe) reset(expected int) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.expected = expected
+	p.providers = make(map[int]func() []service.CoreStatus)
+}
+func (p *readinessProbe) set(index int, fn func() []service.CoreStatus) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.providers[index] = fn
+}
+func (p *readinessProbe) handler() http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/healthz", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]string{"status": "ok", "scope": "liveness"})
+	})
+	mux.HandleFunc("/readyz", func(w http.ResponseWriter, r *http.Request) {
+		p.mu.RLock()
+		expected := p.expected
+		providers := make([]func() []service.CoreStatus, expected)
+		for i, fn := range p.providers {
+			if i < len(providers) {
+				providers[i] = fn
+			}
+		}
+		p.mu.RUnlock()
+		ready := expected > 0
+		nodes := make([]map[string]interface{}, 0)
+		for i, fn := range providers {
+			if fn == nil {
+				ready = false
+				continue
+			}
+			statuses := fn()
+			if len(statuses) == 0 {
+				ready = false
+			}
+			for _, s := range statuses {
+				nodeReady := s.State == "running" && s.Ready
+				if !nodeReady {
+					ready = false
+				}
+				nodes = append(nodes, map[string]interface{}{"instance": i, "state": s.State, "ready": nodeReady, "users": s.Users, "applied_users": s.AppliedUsers})
+			}
+		}
+		status := "not_ready"
+		code := http.StatusServiceUnavailable
+		if ready {
+			status = "ready"
+			code = http.StatusOK
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(code)
+		_ = json.NewEncoder(w).Encode(map[string]interface{}{"status": status, "scope": "proxy_readiness", "nodes": nodes})
+	})
+	return mux
+}
diff --git a/cmd/xboard-node/health_test.go b/cmd/xboard-node/health_test.go
