+
+// Only a still-valid self-generated certificate for this domain may be reused.
+// Old caches without source metadata are regenerated once rather than guessing
+// whether a file/content/ACME certificate belongs to the new self configuration.
+func (m *Manager) matchesPersistedSelfSigned(certPEM []byte) bool {
+	data, err := os.ReadFile(filepath.Join(m.cfg.CertDir, "certificate.json"))
+	if err != nil {
+		return false
+	}
+	var metadata persistedCertMetadata
+	if json.Unmarshal(data, &metadata) != nil || metadata.Mode != "self" || metadata.Domain != selfSignedDomain(m.cfg.Domain) {
+		return false
+	}
+	sum := sha256.Sum256(certPEM)
+	if metadata.CertificateSHA256 != hex.EncodeToString(sum[:]) {
+		return false
+	}
+	block, _ := pem.Decode(certPEM)
+	if block == nil {
+		return false
+	}
+	leaf, err := x509.ParseCertificate(block.Bytes)
+	if err != nil {
+		return false
+	}
+	now := time.Now()
+	return !now.Before(leaf.NotBefore) && now.Before(leaf.NotAfter) && leaf.VerifyHostname(metadata.Domain) == nil
+}
