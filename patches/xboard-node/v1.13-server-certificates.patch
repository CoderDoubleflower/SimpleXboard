diff --git a/internal/cert/self_cache_test.go b/internal/cert/self_cache_test.go
new file mode 100644
index 0000000..c9bc8bc
--- /dev/null
+++ b/internal/cert/self_cache_test.go
@@ -0,0 +1,145 @@
+package cert
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/cedar2025/xboard-node/internal/config"
+)
+
+func requireSelfDomain(t *testing.T, m *Manager, domain string) {
+	t.Helper()
+	block, _ := pem.Decode(m.TLSCert().CertPEM)
+	if block == nil {
+		t.Fatal("missing certificate PEM")
+	}
+	leaf, err := x509.ParseCertificate(block.Bytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := leaf.VerifyHostname(domain); err != nil {
+		t.Fatal(err)
+	}
+	if time.Now().Before(leaf.NotBefore) || !time.Now().Before(leaf.NotAfter) {
+		t.Fatal("self certificate is outside its validity period")
+	}
+}
+
+func TestSelfCertificateDoesNotReuseAnotherSource(t *testing.T) {
+	for _, mode := range []string{"file", "content"} {
+		for _, domain := range []string{"old.example.test", "new.example.test"} {
+			t.Run(mode+"/"+domain, func(t *testing.T) {
+				certPEM, keyPEM := generateSelfSignedPair(t, "old.example.test")
+				dir := t.TempDir()
+				certPath, keyPath := filepath.Join(dir, "provided.pem"), filepath.Join(dir, "provided-key.pem")
+				if err := os.WriteFile(certPath, certPEM, 0600); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(keyPath, keyPEM, 0600); err != nil {
+					t.Fatal(err)
+				}
+				m := NewManager(config.CertConfig{CertMode: mode, CertDir: dir, CertFile: certPath, KeyFile: keyPath,
+					CertContent: string(certPEM), KeyContent: string(keyPEM)})
+				if err := m.Start(context.Background()); err != nil {
+					t.Fatal(err)
+				}
+				changed, err := m.Reconfigure(context.Background(), config.CertConfig{CertMode: "self", Domain: domain})
+				if err != nil || !changed || string(m.TLSCert().CertPEM) == string(certPEM) {
+					t.Fatalf("self reused %s material: changed=%v err=%v", mode, changed, err)
+				}
+				requireSelfDomain(t, m, domain)
+			})
+		}
+	}
+}
+
+func TestSelfCertificateStableRestartAndDomainChange(t *testing.T) {
+	cfg := config.CertConfig{CertMode: "self", CertDir: t.TempDir(), Domain: "a.example.test"}
+	m := NewManager(cfg)
+	if err := m.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	initial := m.TLSCert()
+	changed, err := m.Reconfigure(context.Background(), cfg)
+	if err != nil || changed || !pemEqual(initial, m.TLSCert()) {
+		t.Fatalf("unchanged self source rotated certificate: changed=%v err=%v", changed, err)
+	}
+	warm := NewManager(cfg)
+	if err := warm.Start(context.Background()); err != nil || !pemEqual(initial, warm.TLSCert()) {
+		t.Fatalf("warm restart did not retain matching self certificate: %v", err)
+	}
+	cfg.Domain = "b.example.test"
+	changed, err = warm.Reconfigure(context.Background(), cfg)
+	if err != nil || !changed || pemEqual(initial, warm.TLSCert()) {
+		t.Fatalf("domain change reused old material: changed=%v err=%v", changed, err)
+	}
+	requireSelfDomain(t, warm, cfg.Domain)
+}
+
+func TestSelfCertificateRejectsStaleCacheMetadataAndExpiredMaterial(t *testing.T) {
+	for _, condition := range []string{"legacy", "hash_mismatch", "hostname_mismatch", "expired"} {
+		t.Run(condition, func(t *testing.T) {
+			const domain = "new.example.test"
+			cfg := config.CertConfig{CertMode: "self", CertDir: t.TempDir(), Domain: domain}
+			certDomain := domain
+			if condition == "hostname_mismatch" {
+				certDomain = "wrong.example.test"
+			}
+			key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ends := time.Now().Add(time.Hour)
+			if condition == "expired" {
+				ends = time.Now().Add(-time.Hour)
+			}
+			tmpl := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: certDomain},
+				DNSNames: []string{certDomain}, NotBefore: time.Now().Add(-24 * time.Hour), NotAfter: ends,
+				KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+			der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+			if err != nil {
+				t.Fatal(err)
+			}
+			keyDER, err := x509.MarshalECPrivateKey(key)
+			if err != nil {
+				t.Fatal(err)
+			}
+			old := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+			m := NewManager(cfg)
+			m.storePEM(old, pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: keyDER}))
+			metadataPath := filepath.Join(cfg.CertDir, "certificate.json")
+			if condition == "legacy" {
+				if err := os.Remove(metadataPath); err != nil {
+					t.Fatal(err)
+				}
+			} else if condition == "hash_mismatch" {
+				sum := sha256.Sum256([]byte("different certificate"))
+				data, _ := json.Marshal(persistedCertMetadata{Mode: "self", Domain: domain, CertificateSHA256: hex.EncodeToString(sum[:])})
+				if err := os.WriteFile(metadataPath, data, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			warm := NewManager(cfg)
+			if err := warm.Start(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+			if string(warm.TLSCert().CertPEM) == string(old) {
+				t.Fatal("unusable cache was reused")
+			}
+			requireSelfDomain(t, warm, domain)
+		})
+	}
+}
