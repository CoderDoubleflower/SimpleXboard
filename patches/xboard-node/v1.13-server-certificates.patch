new file mode 100644
index 0000000..798cf49
--- /dev/null
+++ b/internal/service/certificate_lifecycle_test.go
@@ -0,0 +1,142 @@
+package service
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/cedar2025/xboard-node/internal/cert"
+	"github.com/cedar2025/xboard-node/internal/config"
+	"github.com/cedar2025/xboard-node/internal/controlplane"
+	"github.com/cedar2025/xboard-node/internal/model"
+)
+
+type certificateKernel struct{ fakeKernel }
+
+func (k *certificateKernel) Protocols() []string { return []string{"hysteria"} }
+
+func certificatePair(t *testing.T) (string, string) {
+	t.Helper()
+	manager := cert.NewManager(config.CertConfig{CertMode: "self", Domain: "localhost"})
+	if err := manager.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	pair := manager.TLSCert()
+	dir := t.TempDir()
+	certPath, keyPath := filepath.Join(dir, "cert.pem"), filepath.Join(dir, "key.pem")
+	if err := os.WriteFile(certPath, pair.CertPEM, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(keyPath, pair.KeyPEM, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return certPath, keyPath
+}
+
+func newCertificateService() (*Service, *certificateKernel) {
+	k := &certificateKernel{}
+	s := newTestService(&k.fakeKernel)
+	s.kernel = k
+	s.lastUsers = []model.UserSpec{{ID: 1, UUID: "test-user"}}
+	s.lastUserHash = computeUserHash(s.lastUsers)
+	return s, k
+}
+
+func fileCertificateSpec(certPath, keyPath string) *model.NodeSpec {
+	return &model.NodeSpec{
+		Protocol: "hysteria", Version: 2, ServerPort: 10443,
+		CertConfig: &config.CertConfig{CertMode: "file", CertFile: certPath, KeyFile: keyPath},
+	}
+}
+
+func TestCertificateFailuresStopCoreAndPreserveSpecificError(t *testing.T) {
+	certPath, keyPath := certificatePair(t)
+	_, otherKey := certificatePair(t)
+	malformed := filepath.Join(t.TempDir(), "malformed.pem")
+	if err := os.WriteFile(malformed, []byte("not a certificate"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name, certPath, keyPath, want string
+	}{
+		{"missing_certificate", certPath + ".missing", keyPath, "cert file: open "},
+		{"missing_private_key", certPath, keyPath + ".missing", "key file: open "},
+		{"unreadable_certificate", t.TempDir(), keyPath, "is a directory"},
+		{"invalid_pem", malformed, keyPath, "failed to find any PEM data in certificate input"},
+		{"mismatched_key", certPath, otherKey, "private key does not match public key"},
+	}
+	for _, running := range []bool{false, true} {
+		stage := map[bool]string{false: "startup", true: "reload"}[running]
+		for _, tc := range cases {
+			t.Run(stage+"/"+tc.name, func(t *testing.T) {
+				s, k := newCertificateService()
+				if running {
+					s.lastConfig = fileCertificateSpec(certPath, keyPath)
+					s.reconcileKernel(context.Background())
+					if !s.Status().Ready || !k.running {
+						t.Fatal("valid baseline did not start")
+					}
+				}
+				starts, reloads := k.startCalls, k.reloadCalls
+				s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncConfig, Config: fileCertificateSpec(tc.certPath, tc.keyPath)})
+				status := s.Status()
+				if k.running || status.Ready || status.State != "error" || status.AppliedUsers != 0 {
+					t.Fatalf("failed certificate left a ready core: %+v", status)
+				}
+				if !strings.Contains(status.Error, "certificate configuration (file): cert reconfigure: ") || !strings.Contains(status.Error, tc.want) {
+					t.Fatalf("detailed certificate failure was lost: %s", status.Error)
+				}
+				if k.startCalls != starts || k.reloadCalls != reloads || s.retryAt.IsZero() {
+					t.Fatal("failed certificate reached kernel start/reload or did not schedule retry")
+				}
+				// The same service recovers through a corrected panel config.
+				s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncConfig, Config: fileCertificateSpec(certPath, keyPath)})
+				if !k.running || !s.Status().Ready || s.Status().Error != "" {
+					t.Fatalf("corrected certificate did not recover: %+v", s.Status())
+				}
+			})
+		}
+	}
+}
+
+func TestCertificatePermissionDeniedIsReported(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("root bypasses Unix read permissions; this case runs on the non-root CI runner")
+	}
+	certPath, keyPath := certificatePair(t)
+	if err := os.Chmod(keyPath, 0000); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(keyPath, 0600) })
+	s, k := newCertificateService()
+	s.lastConfig = fileCertificateSpec(certPath, keyPath)
+	s.reconcileKernel(context.Background())
+	if k.running || !strings.Contains(s.Status().Error, "permission denied") || !strings.Contains(s.Status().Error, "key file") {
+		t.Fatalf("private-key permission error was lost: %+v", s.Status())
+	}
+	if err := os.Chmod(keyPath, 0600); err != nil {
+		t.Fatal(err)
+	}
+	s.resetRetry()
+	s.reconcileKernel(context.Background())
+	if !k.running || !s.Status().Ready {
+		t.Fatalf("corrected file permissions did not recover on retry: %+v", s.Status())
+	}
+}
+
+func TestCertificateNoneDoesNotReuseOldMaterial(t *testing.T) {
+	certPath, keyPath := certificatePair(t)
+	s, k := newCertificateService()
+	s.lastConfig = fileCertificateSpec(certPath, keyPath)
+	s.reconcileKernel(context.Background())
+	if !k.running || !s.Status().Ready {
+		t.Fatal("valid baseline did not start")
+	}
+	desired := &model.NodeSpec{Protocol: "hysteria", Version: 2, ServerPort: 10443, CertConfig: &config.CertConfig{CertMode: "none"}}
+	s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncConfig, Config: desired})
+	if k.running || s.Status().Ready || s.cert.HasCert() || !strings.Contains(s.Status().Error, "requires TLS certificate") {
+		t.Fatalf("none reused a previously loaded certificate: %+v", s.Status())
+	}
+}
