+++ b/internal/service/certificate_renewal_test.go
@@ -0,0 +1,163 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/cedar2025/xboard-node/internal/cert"
+	"github.com/cedar2025/xboard-node/internal/config"
+	"github.com/cedar2025/xboard-node/internal/controlplane"
+	"github.com/cedar2025/xboard-node/internal/kernel"
+	"github.com/cedar2025/xboard-node/internal/model"
+)
+
+// Model certmagic's atomic material update followed by its renewal signal.
+// No external CA, network request, or test-only production API is needed.
+type renewingCertificate struct {
+	*cert.Manager
+	material atomic.Pointer[kernel.TLSCert]
+	renewed  atomic.Bool
+}
+
+func (m *renewingCertificate) TLSCert() kernel.TLSCert {
+	if material := m.material.Load(); material != nil {
+		return *material
+	}
+	return kernel.TLSCert{}
+}
+func (m *renewingCertificate) CertRenewed() bool { return m.renewed.Swap(false) }
+func (m *renewingCertificate) Reconfigure(context.Context, config.CertConfig) (bool, error) {
+	return false, nil // An unchanged running ACME configuration is idempotent.
+}
+func (m *renewingCertificate) publish(value string, renewed bool) {
+	m.material.Store(&kernel.TLSCert{CertPEM: []byte(value), KeyPEM: []byte("key")})
+	m.renewed.Store(renewed)
+}
+
+type certificateRecordingKernel struct {
+	certificateKernel
+	applied chan kernel.TLSCert
+}
+
+func (k *certificateRecordingKernel) Start(spec *model.NodeSpec, users []model.UserSpec, material kernel.TLSCert) error {
+	if err := k.fakeKernel.Start(spec, users, material); err != nil {
+		return err
+	}
+	k.applied <- material
+	return nil
+}
+func (k *certificateRecordingKernel) Reload(spec *model.NodeSpec, users []model.UserSpec, material kernel.TLSCert) error {
+	if err := k.fakeKernel.Reload(spec, users, material); err != nil {
+		return err
+	}
+	k.applied <- material
+	return nil
+}
+
+type certificateRenewalSource struct {
+	bootstrapOnlySource
+	polls atomic.Int32
+}
+
+func (f *certificateRenewalSource) Poll(context.Context) (controlplane.Snapshot, error) {
+	f.polls.Add(1)
+	return controlplane.Snapshot{}, errors.New("REST unavailable")
+}
+func (f *certificateRenewalSource) SupportsPolling() bool { return true }
+
+type certificateRenewalSink struct{ controlplane.Sink }
+
+func (certificateRenewalSink) SupportsReporting() bool     { return false }
+func (certificateRenewalSink) SupportsDeviceReports() bool { return false }
+
+func renewalService() (*Service, *certificateRecordingKernel, *renewingCertificate) {
+	k := &certificateRecordingKernel{applied: make(chan kernel.TLSCert, 8)}
+	s := newTestService(&k.fakeKernel)
+	s.kernel = k
+	m := &renewingCertificate{Manager: cert.NewManager(config.CertConfig{})}
+	m.publish("initial", false)
+	s.cert = m
+	s.lastConfig = &model.NodeSpec{Protocol: "hysteria", Version: 2, ServerPort: 10443,
+		CertConfig: &config.CertConfig{CertMode: "http", Domain: "example.test"}}
+	s.updateUserState([]model.UserSpec{{ID: 1, UUID: "test-user"}})
+	return s, k, m
+}
+
+func awaitCertificate(t *testing.T, ch <-chan kernel.TLSCert, want string) {
+	t.Helper()
+	select {
+	case material := <-ch:
+		if string(material.CertPEM) != want {
+			t.Fatalf("kernel received %q, want %q", material.CertPEM, want)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatalf("kernel never received %s certificate", want)
+	}
+}
+
+func TestCertificateRenewalReloadsWithWebSocketContinuouslyConnected(t *testing.T) {
+	s, k, m := renewalService()
+	source := &certificateRenewalSource{bootstrapOnlySource: bootstrapOnlySource{bootstrap: controlplane.Bootstrap{
+		Config: s.lastConfig, Users: s.lastUsers, Push: bootstrapPush{},
+	}}}
+	s.source, s.sink = source, certificateRenewalSink{}
+	s.cfg.Node = config.NodeConfig{PushInterval: 3600, PullInterval: 1, TrackInterval: 3600, DeviceReportInterval: 3600}
+	s.cfg.WS.DiscoveryInterval = 3600
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- s.Run(ctx) }()
+	t.Cleanup(func() {
+		cancel()
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Errorf("service stopped with error: %v", err)
+			}
+		case <-time.After(3 * time.Second):
+			t.Error("service did not stop")
+		}
+	})
+	awaitCertificate(t, k.applied, "initial")
+	m.publish("renewed", true)
+	awaitCertificate(t, k.applied, "renewed")
+	if source.polls.Load() != 0 {
+		t.Fatal("renewal depended on REST despite continuously connected WebSocket")
+	}
+	select {
+	case <-k.applied:
+		t.Fatal("one renewal caused duplicate reloads")
+	case <-time.After(1200 * time.Millisecond):
+	}
+}
+
+func TestCertificateRenewalSurvivesNoUsersAndFailedREST(t *testing.T) {
+	s, k, m := renewalService()
+	source := &certificateRenewalSource{}
+	s.source = source
+	s.pullResults = make(chan pullResult, 1)
+	s.reconcileKernel(context.Background())
+	awaitCertificate(t, k.applied, "initial")
+	s.updateUserState(nil)
+	s.reconcileKernel(context.Background())
+	m.publish("renewed", true)
+	s.pullViaAPIAsync(context.Background())
+	deadline := time.Now().Add(time.Second)
+	for s.pullActive.Load() && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if s.pullActive.Load() || source.polls.Load() != 1 {
+		t.Fatal("failed REST poll did not complete")
+	}
+	s.reconcileKernel(context.Background())
+	if k.running || s.Status().State != "waiting_users" || !s.forceReload {
+		t.Fatal("renewal started an empty node or lost its pending reload")
+	}
+	s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "test-user"}}, "")
+	awaitCertificate(t, k.applied, "renewed")
+	if !s.Status().Ready {
+		t.Fatal("new users did not start with the renewed certificate")
+	}
+}
