+
+func outboundRuntimeNode() *model.NodeSpec {
+	return &model.NodeSpec{Protocol: "socks", ListenIP: "127.0.0.1", ServerPort: 0}
+}
+
+func testSocksOutbound(address string) model.OutboundConfig {
+	return model.OutboundConfig{Tag: "sx-outbound-7", Protocol: "socks", Settings: map[string]any{"server": address, "server_port": 1080}}
+}
+
+func startOutboundTestCore(t *testing.T, core *SingBox, node *model.NodeSpec, users []model.UserSpec) {
+	t.Helper()
+	if err := core.Start(node, users, kernel.TLSCert{}); err != nil {
+		// Some local sandboxes prohibit NETLINK_ROUTE, used by sing-box's
+		// network monitor. CI must run these real-core tests without skipping.
+		if runtime.GOOS == "linux" && errors.Is(err, syscall.EPERM) && os.Getenv("CI") == "" {
+			t.Skipf("local sandbox denies sing-box network monitor; required in CI: %v", err)
+		}
+		t.Fatal(err)
+	}
+	t.Cleanup(core.Stop)
+}
+
+func TestManagedOutboundParsesWithPinnedCore(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, outbound := range []model.OutboundConfig{
+		{Tag: "sx-outbound-1", Protocol: "vless", Settings: map[string]any{
+			"server": "192.0.2.1", "server_port": 443, "uuid": "11111111-1111-4111-8111-111111111111", "flow": "xtls-rprx-vision",
+			"tls": map[string]any{"enabled": true, "server_name": "www.example.com", "utls": map[string]any{"enabled": true, "fingerprint": "chrome"},
+				"reality": map[string]any{"enabled": true, "public_key": base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()), "short_id": "0123456789abcdef"}},
+		}},
+		{Tag: "sx-outbound-2", Protocol: "hysteria2", Settings: map[string]any{
+			"server": "192.0.2.2", "server_port": 8443, "password": "outbound-test-password",
+			"tls":  map[string]any{"enabled": true, "server_name": "example.com"},
+			"obfs": map[string]any{"type": "salamander", "password": "obfs-test-password"},
+		}},
+		{Tag: "sx-outbound-3", Protocol: "socks", Settings: map[string]any{
+			"server": "192.0.2.3", "server_port": 1080, "version": "5", "username": "user", "password": "outbound-test-password",
+		}},
+		{Tag: "sx-outbound-4", Protocol: "socks", Settings: map[string]any{
+			"server": "192.0.2.4", "server_port": 1080, "version": "5",
+		}},
+		{Tag: "sx-outbound-5", Protocol: "shadowsocks", Settings: map[string]any{
+			"server": "192.0.2.5", "server_port": 8388, "method": "aes-128-gcm", "password": "outbound-test-password",
+		}},
+		{Tag: "sx-outbound-6", Protocol: "trojan", Settings: map[string]any{
+			"server": "192.0.2.6", "server_port": 443, "password": "outbound-test-password",
+			"tls": map[string]any{"enabled": true, "server_name": "example.com"},
+		}},
+		{Tag: "sx-outbound-7", Protocol: "vmess", Settings: map[string]any{
+			"server": "192.0.2.7", "server_port": 443, "uuid": "11111111-1111-4111-8111-111111111111", "security": "auto", "alter_id": 0,
+			"tls": map[string]any{"enabled": true, "server_name": "example.com"},
+		}},
+	} {
+		t.Run(outbound.Protocol, func(t *testing.T) {
+			node := outboundRuntimeNode()
+			node.DefaultOutbound = outbound.Tag
+			node.CustomOutbounds = []model.OutboundConfig{outbound}
+			generated := buildConfig(config.KernelConfig{Type: "singbox", LogLevel: "error"}, node, testUsers, kernel.TLSCert{})
+			if final := generated["route"].(M)["final"]; final != outbound.Tag {
+				t.Fatalf("default is %v", final)
+			}
+			if direct := generated["outbounds"].([]M)[0]; direct["tag"] != "direct" || direct["type"] != "direct" {
+				t.Fatalf("direct outbound was replaced: %#v", direct)
+			}
+			data, err := json.Marshal(generated)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx := include.Context(context.Background())
+			opts, err := singJSON.UnmarshalExtendedContext[option.Options](ctx, data)
+			if err != nil {
+				t.Fatalf("pinned core rejected generated options: %v", err)
+			}
+			instance, err := box.New(box.Options{Context: ctx, Options: opts})
+			if err != nil {
+				t.Fatalf("pinned core rejected outbound construction: %v", err)
+			}
+			defer instance.Close()
+		})
+	}
+}
