+func TestDefaultOutboundPreservesLegacyCustomDefault(t *testing.T) {
+	customPath := filepath.Join(t.TempDir(), "custom.json")
+	if err := os.WriteFile(customPath, []byte(`{"route":{"final":"block"}}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	kcfg := config.KernelConfig{CustomConfig: customPath}
+	node := outboundRuntimeNode()
+	if got := buildConfig(kcfg, node, testUsers, kernel.TLSCert{})["route"].(M)["final"]; got != "block" {
+		t.Fatalf("legacy custom default changed: %v", got)
+	}
+	node.DefaultOutbound = "sx-outbound-7"
+	node.CustomOutbounds = []model.OutboundConfig{testSocksOutbound("192.0.2.1")}
+	if got := buildConfig(kcfg, node, testUsers, kernel.TLSCert{})["route"].(M)["final"]; got != "sx-outbound-7" {
+		t.Fatalf("custom file overrode explicit panel default: %v", got)
+	}
+}
+
+func TestSingBoxOutboundChangesRequireRestart(t *testing.T) {
+	for _, name := range []string{"add", "address", "default", "remove"} {
+		t.Run(name, func(t *testing.T) {
+			node := outboundRuntimeNode()
+			if name != "add" {
+				node.CustomOutbounds = []model.OutboundConfig{testSocksOutbound("192.0.2.1")}
+				node.DefaultOutbound = "sx-outbound-7"
+			}
+			s := New(config.KernelConfig{Type: "singbox", LogLevel: "error"})
+			startOutboundTestCore(t, s, node, testUsers)
+			next := *node
+			switch name {
+			case "add":
+				next.CustomOutbounds = []model.OutboundConfig{testSocksOutbound("192.0.2.1")}
+				next.DefaultOutbound = "sx-outbound-7"
+			case "address":
+				next.CustomOutbounds = []model.OutboundConfig{testSocksOutbound("192.0.2.2")}
+			case "default":
+				next.DefaultOutbound = "direct"
+			case "remove":
+				next.DefaultOutbound = ""
+				next.CustomOutbounds = nil
+			}
+			if err := s.Reload(&next, testUsers, kernel.TLSCert{}); !errors.Is(err, kernel.ErrRestartRequired) {
+				t.Fatalf("outbound change was silently accepted: %v", err)
+			}
+			if s.nodeConfig != node {
+				t.Fatal("unapplied desired configuration replaced the applied state")
+			}
+		})
+	}
+}
+
+func TestSingBoxUserUpdateKeepsOutboundsAndInstance(t *testing.T) {
+	node := outboundRuntimeNode()
+	node.CustomOutbounds = []model.OutboundConfig{testSocksOutbound("192.0.2.1")}
+	node.DefaultOutbound = "sx-outbound-7"
+	s := New(config.KernelConfig{Type: "singbox", LogLevel: "error"})
+	startOutboundTestCore(t, s, node, testUsers[:1])
+	instance, outboundHash := s.box, s.outboundHash
+	if _, _, err := s.UpdateUsers(testUsers); err != nil {
+		t.Fatal(err)
+	}
+	if s.box != instance || s.outboundHash != outboundHash {
+		t.Fatal("user-only change rebuilt the core or changed outbounds")
+	}
+}
+
+func TestSingBoxRoutingFailureIsNotReportedAsApplied(t *testing.T) {
+	node := outboundRuntimeNode()
+	s := New(config.KernelConfig{Type: "singbox", LogLevel: "error"})
+	startOutboundTestCore(t, s, node, testUsers)
+	next := *node
+	next.CustomRoutes = []map[string]any{{"rule_set": []string{"missing-ruleset"}, "outbound": "direct"}}
+	err := s.Reload(&next, testUsers, kernel.TLSCert{})
+	if err == nil || !strings.Contains(err.Error(), "update routing rules") {
+		t.Fatalf("routing error was swallowed: %v", err)
+	}
+	if s.nodeConfig != node {
+		t.Fatal("failed route configuration was recorded as applied")
+	}
+}
+
+func TestProxyTagCompilesToSingBoxDetour(t *testing.T) {
+	outbound := testSocksOutbound("192.0.2.1")
+	outbound.ProxyTag = "direct"
+	data, err := json.Marshal(outboundConfigToSingbox(outbound))
+	if err != nil {
+		t.Fatal(err)
+	}
+	opts, err := singJSON.UnmarshalExtendedContext[option.Outbound](include.Context(context.Background()), data)
+	if err != nil {
+		t.Fatalf("pinned core rejected chained outbound: %v", err)
+	}
+	if got := opts.Options.(*option.SOCKSOutboundOptions).Detour; got != "direct" {
+		t.Fatalf("chain reference lost: %q", got)
+	}
+}
