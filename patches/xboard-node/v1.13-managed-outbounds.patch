+package model
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/cedar2025/xboard-node/internal/config"
+	"github.com/cedar2025/xboard-node/internal/panel"
+)
+
+func TestDefaultOutboundValidationAndRoundTrip(t *testing.T) {
+	for _, tc := range []struct {
+		name, kernel, tag, wantError string
+	}{
+		{name: "legacy", kernel: "singbox"},
+		{name: "direct", kernel: "singbox", tag: "direct"},
+		{name: "selected", kernel: "singbox", tag: "sx-outbound-7"},
+		{name: "trimmed", kernel: "singbox", tag: " sx-outbound-7 "},
+		{name: "unknown", kernel: "singbox", tag: "missing", wantError: "unknown outbound"},
+		{name: "case_sensitive", kernel: "singbox", tag: "SX-OUTBOUND-7", wantError: "unknown outbound"},
+		{name: "xray_legacy", kernel: "xray"},
+		{name: "xray_direct", kernel: "xray", tag: "direct"},
+		{name: "xray_managed", kernel: "xray", tag: "sx-outbound-7", wantError: "requires the singbox kernel"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			wire := &panel.NodeConfig{
+				Protocol: "vless", ServerPort: 17881, DefaultOutbound: tc.tag,
+				CustomOutbounds: []panel.OutboundConfig{{Tag: "sx-outbound-7", Protocol: "socks", Settings: map[string]any{"server": "192.0.2.1", "server_port": 1080}}},
+			}
+			data, err := json.Marshal(wire)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var decoded panel.NodeConfig
+			if err := json.Unmarshal(data, &decoded); err != nil {
+				t.Fatal(err)
+			}
+			spec, err := NodeSpecFromPanelValidated(&decoded, config.KernelConfig{Type: tc.kernel})
+			if tc.wantError != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.wantError) {
+					t.Fatalf("expected %q, got %v", tc.wantError, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := spec.ToPanel().DefaultOutbound; got != strings.TrimSpace(tc.tag) {
+				t.Fatalf("default lost in round trip: %q", got)
+			}
+		})
+	}
+}
