@@ -0,0 +1,128 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/cedar2025/xboard-node/internal/config"
+	"github.com/cedar2025/xboard-node/internal/controlplane"
+	"github.com/cedar2025/xboard-node/internal/kernel"
+	"github.com/cedar2025/xboard-node/internal/model"
+	"github.com/cedar2025/xboard-node/internal/panel"
+)
+
+func managedOutboundSpec() *model.NodeSpec {
+	return &model.NodeSpec{
+		Protocol: "vless", ServerPort: 17881, DefaultOutbound: "sx-outbound-7",
+		CustomOutbounds: []model.OutboundConfig{{Tag: "sx-outbound-7", Protocol: "socks", Settings: map[string]any{"server": "192.0.2.1", "server_port": 1080}}},
+	}
+}
+
+func TestManagedOutboundInvalidRESTStopsPriorDirectCore(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if strings.HasSuffix(r.URL.Path, "/config") {
+			_, _ = w.Write([]byte(`{"protocol":"vless","server_port":17881,"default_outbound":"missing"}`))
+		} else {
+			_, _ = w.Write([]byte(`{"users":[{"id":1,"uuid":"user-1"}],"websocket":{"enabled":false}}`))
+		}
+	}))
+	defer server.Close()
+	for _, machine := range []bool{false, true} {
+		t.Run(map[bool]string{false: "legacy_api", true: "machine_api"}[machine], func(t *testing.T) {
+			k := &fakeKernel{}
+			s := newTestService(k)
+			s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+			s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "user-1"}}, "")
+			pc := config.PanelConfig{URL: server.URL, NodeID: 1}
+			if machine {
+				pc.MachineID = 1
+				s.source = controlplane.NewMachinePanelControlPlane(panel.NewClient(pc), s.cfg.Kernel, nil, nil)
+			} else {
+				s.source = controlplane.NewPanelControlPlane(pc, config.WSConfig{}, s.cfg.Kernel)
+			}
+			snapshot, err := s.source.Poll(context.Background())
+			if err != nil {
+				t.Fatalf("managed intent discarded before lifecycle: %v", err)
+			}
+			s.applyPullResult(context.Background(), pullResult{config: snapshot.Config, configHash: computeConfigHash(snapshot.Config), users: snapshot.Users, userHash: computeUserHash(snapshot.Users)})
+			if status := s.Status(); k.running || status.Ready || status.State != "error" || !strings.Contains(status.Error, "unknown outbound") {
+				t.Fatalf("invalid managed exit left direct running: %+v", status)
+			}
+		})
+	}
+}
+
+func TestManagedOutboundRestartUsesSafeLifecycle(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(map[bool]string{false: "success", true: "failure"}[fail], func(t *testing.T) {
+			k := &fakeKernel{}
+			s := newTestService(k)
+			s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+			s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "user-1"}}, "")
+			k.reloadErr = kernel.ErrRestartRequired
+			if fail {
+				k.startErr = errors.New("invalid outbound authentication")
+			}
+			s.handleWSEvent(context.Background(), controlplane.Event{Type: controlplane.EventSyncConfig, Config: managedOutboundSpec()})
+			if k.reloadCalls != 1 || k.startCalls != 2 || k.stopCalls < 1 {
+				t.Fatalf("unexpected lifecycle counts: starts=%d stops=%d reloads=%d", k.startCalls, k.stopCalls, k.reloadCalls)
+			}
+			status := s.Status()
+			if fail {
+				if k.running || status.Ready || status.State != "error" || status.AppliedUsers != 0 {
+					t.Fatalf("failed exit kept serving old direct configuration: %+v", status)
+				}
+				if s.lastConfig.DefaultOutbound != "sx-outbound-7" {
+					t.Fatal("failed desired exit was lost")
+				}
+			} else if !k.running || !status.Ready || s.appliedState.Config.DefaultOutbound != "sx-outbound-7" {
+				t.Fatalf("new exit was not applied: %+v", status)
+			}
+		})
+	}
+}
+
+func TestManagedOutboundInvalidPushStopsPriorDirectCore(t *testing.T) {
+	for _, name := range []string{"unknown", "xray"} {
+		t.Run(name, func(t *testing.T) {
+			k := &fakeKernel{}
+			s := newTestService(k)
+			if name == "xray" {
+				s.cfg.Kernel.Type = "xray"
+			}
+			s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 17881}
+			s.applyUserUpdate(context.Background(), []model.UserSpec{{ID: 1, UUID: "user-1"}}, "")
+			desired := managedOutboundSpec().ToPanel()
+			wantError := "requires the singbox kernel"
+			if name == "unknown" {
+				desired.DefaultOutbound = "missing"
+				wantError = "unknown outbound"
+			}
+			event, err := controlplane.TranslateWSEvent(panel.WSEvent{Type: panel.WSEventSyncConfig, Config: desired}, s.cfg.Kernel)
+			if err != nil {
+				t.Fatalf("managed intent was discarded before lifecycle could reject it: %v", err)
+			}
+			s.handleWSEvent(context.Background(), event)
+			status := s.Status()
+			if k.running || status.Ready || status.State != "error" || !strings.Contains(status.Error, wantError) {
+				t.Fatalf("invalid managed exit left direct running: %+v", status)
+			}
+			// A corrected explicit direct selection can recover without service restart.
+			desired.DefaultOutbound = "direct"
+			desired.CustomOutbounds = nil
+			event, err = controlplane.TranslateWSEvent(panel.WSEvent{Type: panel.WSEventSyncConfig, Config: desired}, s.cfg.Kernel)
+			if err != nil {
+				t.Fatal(err)
+			}
+			s.handleWSEvent(context.Background(), event)
+			if !s.Status().Ready || !k.running {
+				t.Fatal("corrected configuration did not recover")
+			}
+		})
+	}
+}
