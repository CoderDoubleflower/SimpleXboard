+// Validate exact tag spelling: the kernel's outbound lookup is case-sensitive.
+func validateDefaultOutbound(n *NodeSpec, kernelType string, additionalTags []string) error {
+	tag := strings.TrimSpace(n.DefaultOutbound)
+	if tag == "" || tag == "direct" {
+		return nil
+	}
+	if kernelType != "singbox" {
+		return fmt.Errorf("default_outbound requires the singbox kernel; current kernel is %q", kernelType)
+	}
+	if tag == "block" {
+		return nil
+	}
+	for _, outbound := range n.CustomOutbounds {
+		if outbound.Tag == tag {
+			return nil
+		}
+	}
+	for _, candidate := range additionalTags {
+		if candidate == tag {
+			return nil
+		}
+	}
+	return fmt.Errorf("default_outbound references unknown outbound %q", tag)
+}
