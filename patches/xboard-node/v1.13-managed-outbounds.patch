+package panel
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/cedar2025/xboard-node/internal/config"
+)
+
+func TestManagedOutboundCapabilityOnAuthenticatedRequests(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if got := r.Header.Get("X-SimpleXboard-Features"); got != "managed-outbound-v1" {
+			t.Errorf("missing feature header on %s: %q", r.URL.Path, got)
+		}
+		token := r.URL.Query().Get("token")
+		if r.Method == http.MethodPost {
+			var body map[string]any
+			if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+				t.Error(err)
+			}
+			token, _ = body["token"].(string)
+		}
+		if token != "test-token" {
+			t.Error("request is not authenticated")
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"protocol":"vless","server_port":17881,"default_outbound":"sx-outbound-7","nodes":[],"users":[],"websocket":{"enabled":false}}`))
+	}))
+	defer server.Close()
+	for _, machineID := range []int{0, 12} {
+		client := NewClient(config.PanelConfig{URL: server.URL, Token: "test-token", NodeID: 7, MachineID: machineID})
+		if _, err := client.Handshake(); err != nil {
+			t.Fatal(err)
+		}
+		if got, err := client.GetConfig(); err != nil {
+			t.Fatal(err)
+		} else if got.DefaultOutbound != "sx-outbound-7" {
+			t.Fatalf("default_outbound lost in wire decoding: %q", got.DefaultOutbound)
+		}
+		if _, err := client.GetUsers(); err != nil {
+			t.Fatal(err)
+		}
+		if machineID != 0 {
+			if _, err := client.GetMachineNodes(); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := client.ForNode(9).GetConfig(); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
