+// Explicit managed defaults must reach the serialized lifecycle even when
+// invalid. Discarding them here would leave the previous (possibly direct)
+// config serving traffic. The service validates the complete desired spec
+// before applying it, stops on rejection, and reports the error for recovery.
+// Configs without the new field retain their legacy early-validation behavior.
+func nodeSpecForRuntime(nc *panel.NodeConfig, kcfg config.KernelConfig) (*model.NodeSpec, error) {
+	spec := model.NodeSpecFromPanel(nc)
+	if spec != nil && spec.DefaultOutbound != "" {
+		return spec, nil
+	}
+	if err := model.ValidateNodeSpec(spec, kcfg); err != nil {
+		return nil, err
+	}
+	return spec, nil
+}
